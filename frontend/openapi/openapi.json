            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Mid"
          },
          "mid_source": {
            "type": "string",
            "enum": [
              "binance_usdm_index",
              "binance_spot_tob",
              "bybit_spot_tob",
              "pyth",
              "cex_tradfi_index",
              "proxy_perp_mark_median",
              "equity_ref_same_as_perp"
            ],
            "title": "Mid Source"
          },
          "mid_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Mid Timestamp"
          },
          "mid_stale": {
            "type": "boolean",
            "title": "Mid Stale",
            "default": false
          },
          "effective_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Price"
          },
          "spread_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread Bps"
          },
          "fee_breakdown": {
            "$ref": "#/components/schemas/FeeBreakdown"
          },
          "total_cost_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cost Bps"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_quote",
              "insufficient_liquidity",
              "unsupported_asset",
              "error"
            ],
            "title": "Status"
          },
          "qty_base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qty Base"
          },
          "qty_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "base_from_mid",
                  "quote_exact_in_approx"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Qty Method"
          },
          "venue_mark": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Mark"
          },
          "basis_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Basis Bps"
          },
          "raw_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Ref"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
