{
  "openapi": "3.1.0",
  "info": {
    "title": "spread-comparison-tools",
    "description": "Cross-venue execution quality / spread comparison API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Quotes",
        "description": "Fan out to adapters and return SizeQuotePair rows for one asset/notional.",
        "operationId": "get_quotes_quotes_get",
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Logical asset id, e.g. BTC",
              "title": "Asset"
            },
            "description": "Logical asset id, e.g. BTC"
          },
          {
            "name": "notional",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "USD notional; one of 100 / 1000 / 10000 / 100000 / 1000000 (WHI-799 \u00a74.1)",
              "title": "Notional"
            },
            "description": "USD notional; one of 100 / 1000 / 10000 / 100000 / 1000000 (WHI-799 \u00a74.1)"
          },
          {
            "name": "venues",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated venue slugs; default = all registered adapters",
              "title": "Venues"
            },
            "description": "Comma-separated venue slugs; default = all registered adapters"
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "buy",
                    "sell"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "If set, only that leg is fetched",
              "title": "Side"
            },
            "description": "If set, only that leg is fetched"
          },
          {
            "name": "instrument_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "spot",
                    "perp",
                    "amm_pool",
                    "prop_amm"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Override adapter default instrument type",
              "title": "Instrument Type"
            },
            "description": "Override adapter default instrument type"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/venues": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Venues",
        "description": "Static venue registry + whether an adapter is currently registered.\n\nVenues disabled in ``config/venues.yaml`` are omitted entirely (WHI-840) so\nthey do not appear as quote targets and consume no fan-out budget.",
        "operationId": "get_venues_venues_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VenueResponse"
                  },
                  "type": "array",
                  "title": "Response Get Venues Venues Get"
                }
              }
            }
          }
        }
      }
    },
    "/assets": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Assets",
        "description": "Logical assets + per-venue representation labels (WHI-798 \u00a73.3).",
        "operationId": "get_assets_assets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssetResponse"
                  },
                  "type": "array",
                  "title": "Response Get Assets Assets Get"
                }
              }
            }
          }
        }
      }
    },
    "/fees": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Fees",
        "description": "All validated venue fee schedules (WHI-812; frontend contract for WHI-813).",
        "operationId": "get_fees_fees_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FeeSchedule"
                  },
                  "type": "array",
                  "title": "Response Get Fees Fees Get"
                }
              }
            }
          }
        }
      }
    },
    "/simulate/pairs": {
      "get": {
        "tags": [
          "simulate"
        ],
        "summary": "List valid simulate pair legs",
        "description": "Return tradeable stables and catalogued assets for pair construction.\n\nDiscovery only \u2014 does not change ``POST /simulate`` validation. Clients\nshould not hardcode USDC/USDT; this list is the SSOT (WHI-833).",
        "operationId": "get_simulate_pairs_simulate_pairs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatePairsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/simulate": {
      "post": {
        "tags": [
          "simulate"
        ],
        "summary": "Post Simulate",
        "description": "Fan out a free-form pair trade to adapters; rank by expected output.",
        "operationId": "post_simulate_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Pair validation or request body error. Pair failures use SimulatePairErrorDetail ({message, reason}); pydantic body validation uses the default HTTPValidationError shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatePairErrorDetail"
                }
              }
            }
          },
          "429": {
            "description": "Per-client rate limit for on-demand simulation"
          },
          "503": {
            "description": "Reference mid unavailable or simulator not initialized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "representations": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Representations",
            "description": "Venue slug \u2192 representation label (WHI-798 \u00a73.3)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "representations"
        ],
        "title": "AssetResponse",
        "description": "One row of ``GET /assets``."
      },
      "FeeBreakdown": {
        "properties": {
          "embedded_in_price": {
            "type": "boolean",
            "title": "Embedded In Price"
          },
          "fee_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee Tier"
          },
          "trading_fee_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Fee Bps"
          },
          "trading_fee_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Fee Usd"
          },
          "platform_fee_bps": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Platform Fee Bps",
            "default": "0"
          },
          "lp_fee_tier_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lp Fee Tier Bps"
          },
          "gas_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gas Usd"
          },
          "gas_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gas Bps"
          },
          "gas_unknown": {
            "type": "boolean",
            "title": "Gas Unknown",
            "default": false
          },
          "funding_rate_8h": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Funding Rate 8H"
          },
          "explicit_fee_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explicit Fee Bps"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "embedded_in_price"
        ],
        "title": "FeeBreakdown",
        "description": "Per-quote fee components (WHI-799 \u00a75.4). bps fields are authoritative."
      },
      "FeeSchedule": {
        "properties": {
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "asset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset"
          },
          "instrument_type": {
            "type": "string",
            "enum": [
              "spot",
              "perp",
              "amm_pool",
              "prop_amm"
            ],
            "title": "Instrument Type"
          },
          "maker_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maker Bps"
          },
          "taker_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Taker Bps"
          },
          "tiers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FeeTier"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiers"
          },
          "default_tier": {
            "type": "string",
            "title": "Default Tier",
            "default": "default_taker"
          },
          "lp_fee_tiers_bps": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lp Fee Tiers Bps"
          },
          "gas_estimate_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gas Estimate Usd"
          },
          "funding_model": {
            "type": "string",
            "enum": [
              "none",
              "perp_8h",
              "perp_continuous"
            ],
            "title": "Funding Model",
            "default": "none"
          },
          "fee_embedded_in_quote": {
            "type": "boolean",
            "title": "Fee Embedded In Quote",
            "default": false
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Urls"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "venue",
          "instrument_type",
          "updated_at"
        ],
        "title": "FeeSchedule",
        "description": "Venue-level fee table shape (WHI-799 \u00a75.5). Numbers filled by WHI-812."
      },
      "FeeTier": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "maker_bps": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Maker Bps"
          },
          "taker_bps": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Taker Bps"
          },
          "volume_requirement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume Requirement"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "maker_bps",
          "taker_bps"
        ],
        "title": "FeeTier",
        "description": "One fee tier inside a FeeSchedule (WHI-799 \u00a75.5)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Always 'ok' when the process is serving."
          },
          "adapters_initialized": {
            "type": "integer",
            "title": "Adapters Initialized",
            "description": "Adapters whose startup() completed successfully."
          },
          "adapters_expected": {
            "type": "integer",
            "title": "Adapters Expected",
            "description": "Enabled adapters that should be started (excludes config-disabled)."
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "description": "True when at least one enabled adapter is not initialized."
          },
          "unavailable_venues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unavailable Venues",
            "description": "Enabled venue slugs that failed or have not completed startup."
          }
        },
        "type": "object",
        "required": [
          "status",
          "adapters_initialized",
          "adapters_expected",
          "degraded",
          "unavailable_venues"
        ],
        "title": "HealthResponse",
        "description": "Liveness payload for ``GET /health`` (WHI-840: degradation without flap)."
      },
      "Quote": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "venue_symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Symbol"
          },
          "instrument_type": {
            "type": "string",
            "enum": [
              "spot",
              "perp",
              "amm_pool",
              "prop_amm"
            ],
            "title": "Instrument Type"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side"
          },
          "notional_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Notional Usd"
          },
          "mid": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Mid"
          },
          "mid_source": {
            "type": "string",
            "enum": [
              "binance_usdm_index",
              "binance_spot_tob",
              "bybit_spot_tob",
              "pyth",
              "cex_tradfi_index",
              "proxy_perp_mark_median",
              "equity_ref_same_as_perp"
            ],
            "title": "Mid Source"
          },
          "mid_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Mid Timestamp"
          },
          "mid_stale": {
            "type": "boolean",
            "title": "Mid Stale",
            "default": false
          },
          "effective_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Price"
          },
          "spread_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread Bps"
          },
          "fee_breakdown": {
            "$ref": "#/components/schemas/FeeBreakdown"
          },
          "total_cost_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cost Bps"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_quote",
              "insufficient_liquidity",
              "unsupported_asset",
              "error",
              "rate_limited",
              "excessive_impact"
            ],
            "title": "Status"
          },
          "qty_base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qty Base"
          },
          "qty_method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "base_from_mid",
                  "quote_exact_in_approx"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Qty Method"
          },
          "venue_mark": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Mark"
          },
          "basis_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Basis Bps"
          },
          "raw_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Ref"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "price_impact_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Impact Bps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "venue",
          "asset",
          "instrument_type",
          "side",
          "notional_usd",
          "mid",
          "mid_source",
          "mid_timestamp",
          "fee_breakdown",
          "timestamp",
          "status"
        ],
        "title": "Quote",
        "description": "Single venue quote at a notional size (WHI-799 \u00a76.2)."
      },
      "QuotesResponse": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id"
          },
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "notional_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Notional Usd"
          },
          "mid": {
            "$ref": "#/components/schemas/ReferenceMid"
          },
          "pairs": {
            "items": {
              "$ref": "#/components/schemas/SizeQuotePair"
            },
            "type": "array",
            "title": "Pairs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "asset",
          "notional_usd",
          "mid",
          "pairs"
        ],
        "title": "QuotesResponse",
        "description": "``GET /quotes`` payload."
      },
