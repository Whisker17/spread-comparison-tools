        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "asset",
          "notional_usd",
          "mid",
          "pairs"
        ],
        "title": "QuotesResponse",
        "description": "``GET /quotes`` payload."
      },
