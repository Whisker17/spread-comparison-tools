        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "venue",
          "asset",
          "instrument_type",
          "side",
          "notional_usd",
          "mid",
          "mid_source",
          "mid_timestamp",
          "fee_breakdown",
          "timestamp",
          "status"
        ],
        "title": "Quote",
        "description": "Single venue quote at a notional size (WHI-799 \u00a76.2)."
      },
      "QuotesResponse": {
        "properties": {
          "snapshot_id": {
            "type": "string",
