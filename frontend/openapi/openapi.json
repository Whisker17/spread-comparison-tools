{
  "openapi": "3.1.0",
  "info": {
    "title": "spread-comparison-tools",
    "description": "Cross-venue execution quality / spread comparison API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Quotes",
        "description": "Fan out to adapters and return SizeQuotePair rows for one asset/notional.",
        "operationId": "get_quotes_quotes_get",
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Logical asset id, e.g. BTC",
              "title": "Asset"
            },
            "description": "Logical asset id, e.g. BTC"
          },
          {
            "name": "notional",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "USD notional; one of 1000 / 10000 / 100000 / 1000000 (WHI-799 \u00a74.1)",
              "title": "Notional"
            },
            "description": "USD notional; one of 1000 / 10000 / 100000 / 1000000 (WHI-799 \u00a74.1)"
          },
          {
            "name": "venues",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated venue slugs; default = all registered adapters",
              "title": "Venues"
            },
            "description": "Comma-separated venue slugs; default = all registered adapters"
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "buy",
                    "sell"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "If set, only that leg is fetched",
              "title": "Side"
            },
            "description": "If set, only that leg is fetched"
          },
          {
            "name": "instrument_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "spot",
                    "perp",
                    "amm_pool",
                    "prop_amm"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Override adapter default instrument type",
              "title": "Instrument Type"
            },
            "description": "Override adapter default instrument type"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/venues": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Venues",
        "description": "Static venue registry + whether an adapter is currently registered.",
        "operationId": "get_venues_venues_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VenueResponse"
                  },
                  "type": "array",
                  "title": "Response Get Venues Venues Get"
                }
              }
            }
          }
        }
      }
    },
    "/assets": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Assets",
        "description": "Logical assets + per-venue representation labels (WHI-798 \u00a73.3).",
        "operationId": "get_assets_assets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssetResponse"
                  },
                  "type": "array",
                  "title": "Response Get Assets Assets Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "representations": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Representations",
            "description": "Venue slug \u2192 representation label (WHI-798 \u00a73.3)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "representations"
        ],
        "title": "AssetResponse",
        "description": "One row of ``GET /assets``."
      },
      "FeeBreakdown": {
        "properties": {
          "embedded_in_price": {
            "type": "boolean",
            "title": "Embedded In Price"
          },
          "fee_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee Tier"
          },
          "trading_fee_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Fee Bps"
          },
          "trading_fee_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Fee Usd"
          },
          "platform_fee_bps": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Platform Fee Bps",
            "default": "0"
          },
          "lp_fee_tier_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lp Fee Tier Bps"
          },
          "gas_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gas Usd"
          },
          "gas_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gas Bps"
          },
          "gas_unknown": {
            "type": "boolean",
            "title": "Gas Unknown",
            "default": false
          },
          "funding_rate_8h": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Funding Rate 8H"
          },
          "explicit_fee_bps": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explicit Fee Bps"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "embedded_in_price"
        ],
        "title": "FeeBreakdown",
        "description": "Per-quote fee components (WHI-799 \u00a75.4). bps fields are authoritative."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Always 'ok' when the process is serving."
          },
          "adapters_initialized": {
            "type": "integer",
            "title": "Adapters Initialized",
            "description": "Adapters whose startup() completed successfully."
          }
        },
        "type": "object",
        "required": [
          "status",
          "adapters_initialized"
        ],
        "title": "HealthResponse",
        "description": "Liveness payload for ``GET /health``."
      },
      "Quote": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "venue_symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Symbol"
          },
          "instrument_type": {
