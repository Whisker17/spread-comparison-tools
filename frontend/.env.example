# Backend base URL (no trailing slash). Browser + Next client components read this.
# Development only — copy to .env.local for local overrides (pnpm dev).
# Production builds reject unset and loopback values (WHI-857); set a public
# origin at build time, e.g. NEXT_PUBLIC_API_URL=https://api.example.com pnpm build
NEXT_PUBLIC_API_URL=http://localhost:8000
